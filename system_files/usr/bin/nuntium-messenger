#!/usr/bin/env bash
set -euo pipefail

MSI_PATH="/usr/share/nuntium/app/Nuntium.msi"
BASE_DIR="$HOME/.local/share/nuntium-messenger"
PREFIX_DIR="$BASE_DIR/prefix"
HASH_FILE="$BASE_DIR/.msi.sha256"
LOCK_FILE="$BASE_DIR/install.lock"
LOG_FILE="$BASE_DIR/nuntium.log"

FORCE_REINSTALL=0
RENDER_OVERRIDE=""
APP_ARGS=()

for arg in "$@"; do
    case "$arg" in
        --reinstall)
            FORCE_REINSTALL=1
            ;;
        --software)
            RENDER_OVERRIDE="SOFTWARE"
            ;;
        --opengl)
            RENDER_OVERRIDE="OPENGL"
            ;;
        *)
            APP_ARGS+=("$arg")
            ;;
    esac
done

mkdir -p "$BASE_DIR"

export WINEARCH=win64
export WINEPREFIX="$PREFIX_DIR"
export WINEDLLOVERRIDES="mscoree,mshtml="
export LANG="${LANG:-ru_RU.UTF-8}"
export LC_ALL="${LC_ALL:-ru_RU.UTF-8}"

# Автовыбор рендера для Kotlin/Compose (Skiko):
# В ВМ (VMware/VirtualBox) SOFTWARE исключает черный экран без 3D-ускорения,
# на реальном ноутбуке (AMD Radeon) используется аппаратный OPENGL.
if [ -n "$RENDER_OVERRIDE" ]; then
    export SKIKO_RENDER_API="$RENDER_OVERRIDE"
elif [ -z "${SKIKO_RENDER_API:-}" ]; then
    if systemd-detect-virt -q 2>/dev/null; then
        export SKIKO_RENDER_API="SOFTWARE"
    else
        export SKIKO_RENDER_API="OPENGL"
    fi
fi

find_nuntium_exe() {
    local found=""
    for search_root in \
        "$PREFIX_DIR/drive_c/Program Files" \
        "$PREFIX_DIR/drive_c/Program Files (x86)" \
        "$PREFIX_DIR/drive_c/users"
    do
        if [ -d "$search_root" ]; then
            found=$(find "$search_root" -maxdepth 5 -type f \
                -iname "*nuntium*.exe" \
                ! -iname "*unins*" \
                ! -iname "*update*" \
                ! -iname "*crash*" \
                2>/dev/null | head -n 1 || true)
            if [ -n "$found" ]; then
                echo "$found"
                return 0
            fi
        fi
    done
    return 1
}

if [ ! -f "$MSI_PATH" ]; then
    notify-send -a "Nuntium OS" -u critical "Nuntium не найден" \
        "Файл $MSI_PATH отсутствует в образе ОС." || true
    exit 1
fi

CURRENT_HASH=$(sha256sum "$MSI_PATH" | awk '{print $1}')
INSTALLED_HASH=""
if [ -f "$HASH_FILE" ]; then
    INSTALLED_HASH=$(cat "$HASH_FILE" || true)
fi

# Неблокирующая проверка: если установка уже идет в фоне, показываем уведомление вместо зависания
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    notify-send -a "Nuntium OS" -i nuntium-start "Подготовка Nuntium" \
        "Идет установка мессенджера, подожди несколько секунд..." || true
    exit 0
fi

if [ "$FORCE_REINSTALL" -eq 1 ] || [ "$CURRENT_HASH" != "$INSTALLED_HASH" ] || ! find_nuntium_exe >/dev/null 2>&1; then
    notify-send -a "Nuntium OS" -i nuntium-start "Подготовка Nuntium" \
        "Первичная установка мессенджера (15–30 сек)..." || true

    echo "=== $(date) Установка Nuntium.msi ===" >> "$LOG_FILE"
    if [ "$FORCE_REINSTALL" -eq 1 ]; then
        wineserver -k 2>/dev/null || true
        rm -rf "$PREFIX_DIR"
    fi

    timeout 120 wineboot --init >> "$LOG_FILE" 2>&1 || true
    timeout 60 wineserver -w >> "$LOG_FILE" 2>&1 || true

    if ! timeout 180 wine msiexec /i "$MSI_PATH" /qn /norestart >> "$LOG_FILE" 2>&1; then
        wineserver -k 2>/dev/null || true
        notify-send -a "Nuntium OS" -u critical "Ошибка установки Nuntium" \
            "Подробности в логе: $LOG_FILE" || true
        exit 1
    fi
    timeout 60 wineserver -w >> "$LOG_FILE" 2>&1 || true

    echo "$CURRENT_HASH" > "$HASH_FILE"
    notify-send -a "Nuntium OS" -i nuntium-start "Nuntium готов" \
        "Установка завершена, запускаю мессенджер..." || true
fi

flock -u 9
exec 9>&-

EXE_PATH=$(find_nuntium_exe || true)
if [ -z "$EXE_PATH" ]; then
    notify-send -a "Nuntium OS" -u critical "Nuntium.exe не найден" \
        "MSI установился, но исполняемый файл не найден. Проверь $LOG_FILE" || true
    exit 1
fi

APP_DIR=$(dirname "$EXE_PATH")
cd "$APP_DIR"
exec wine "$EXE_PATH" "${APP_ARGS[@]}" >> "$LOG_FILE" 2>&1