#!/usr/bin/env python3
import json
import subprocess
import sys
import urllib.request
from pathlib import Path

from PyQt6.QtCore import QPointF, QTimer, Qt
from PyQt6.QtGui import QAction, QColor, QIcon, QPainter, QPen, QPixmap, QPolygonF
from PyQt6.QtWidgets import QApplication, QMenu, QMessageBox, QSystemTrayIcon

STATE_FILE = Path("/run/nuntium-vpn/state.json")


def make_shield_icon(fill_hex: str, border_hex: str, letter: str) -> QIcon:
    pix = QPixmap(64, 64)
    pix.fill(Qt.GlobalColor.transparent)
    p = QPainter(pix)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)

    poly = QPolygonF([
        QPointF(32, 4),
        QPointF(56, 14),
        QPointF(52, 38),
        QPointF(32, 60),
        QPointF(12, 38),
        QPointF(8, 14),
    ])
    p.setBrush(QColor(fill_hex))
    p.setPen(QPen(QColor(border_hex), 3))
    p.drawPolygon(poly)

    p.setPen(QColor("#FFFFFF"))
    font = p.font()
    font.setBold(True)
    font.setPixelSize(24)
    p.setFont(font)
    p.drawText(pix.rect(), Qt.AlignmentFlag.AlignCenter, letter)
    p.end()
    return QIcon(pix)


class NuntiumNetTray:
    def __init__(self, app: QApplication) -> None:
        self.app = app
        self.icon_home = make_shield_icon("#1F7A4D", "#4EE096", "W")
        self.icon_vpn = make_shield_icon("#7F77DD", "#C2B9FF", "N")
        self.icon_alert = make_shield_icon("#C9363D", "#FF8A8F", "!")

        self.tray = QSystemTrayIcon(self.icon_home)
        self.tray.setToolTip("Nuntium OS — Защита сети")

        self.menu = QMenu()
        self.status_action = QAction("Статус: проверка...")
        self.status_action.setEnabled(False)
        self.menu.addAction(self.status_action)
        self.menu.addSeparator()

        self.act_home = QAction("Домашний Wi-Fi (роутер с VPN)")
        self.act_home.triggered.connect(lambda: self.switch_mode("home"))
        self.menu.addAction(self.act_home)

        self.act_vpn = QAction("Выездной VPN (Hysteria 2 + Kill-Switch)")
        self.act_vpn.triggered.connect(lambda: self.switch_mode("vpn"))
        self.menu.addAction(self.act_vpn)

        self.menu.addSeparator()

        self.act_tor = QAction("Открыть изолированный Tor-браузер")
        self.act_tor.triggered.connect(self.launch_tor)
        self.menu.addAction(self.act_tor)

        self.act_ip = QAction("Проверить текущий внешний IP")
        self.act_ip.triggered.connect(self.check_ip)
        self.menu.addAction(self.act_ip)

        self.act_edit = QAction("Настроить сервер Hysteria 2")
        self.act_edit.triggered.connect(self.edit_config)
        self.menu.addAction(self.act_edit)

        self.tray.setContextMenu(self.menu)
        self.tray.show()

        self.timer = QTimer()
        self.timer.timeout.connect(self.refresh_status)
        self.timer.start(4000)
        self.refresh_status()

    def refresh_status(self) -> None:
        vpn_active = (
            subprocess.run(
                ["systemctl", "is-active", "nuntium-vpn.service"],
                capture_output=True,
                text=True,
            ).stdout.strip()
            == "active"
        )
        mode = "home"
        if STATE_FILE.exists():
            try:
                mode = json.loads(STATE_FILE.read_text(encoding="utf-8")).get("mode", "home")
            except Exception:
                mode = "home"

        if mode == "vpn" and vpn_active:
            self.tray.setIcon(self.icon_vpn)
            self.status_action.setText("Режим: Hysteria 2 + Kill-Switch")
            self.tray.setToolTip("Nuntium OS: Hysteria 2 активен (Kill-Switch включен)")
        elif mode == "vpn" and not vpn_active:
            self.tray.setIcon(self.icon_alert)
            self.status_action.setText("Туннель оборван (Kill-Switch активен)")
            self.tray.setToolTip("Nuntium OS: ВНИМАНИЕ — трафик заблокирован Kill-Switch")
        else:
            self.tray.setIcon(self.icon_home)
            self.status_action.setText("Режим: Домашний Wi-Fi (защита ПК)")
            self.tray.setToolTip("Nuntium OS: Домашний Wi-Fi (MAC + DoT + Firewall)")

    def switch_mode(self, mode: str) -> None:
        res = subprocess.run(
            ["pkexec", "/usr/libexec/nuntium-net-ctl", mode],
            capture_output=True,
            text=True,
        )
        self.refresh_status()
        if res.returncode != 0:
            err = res.stderr.strip() or res.stdout.strip() or "Неизвестная ошибка"
            QMessageBox.warning(None, "Nuntium OS — Сеть", err)
        else:
            msg = "Включен Hysteria 2 + Kill-Switch" if mode == "vpn" else "Включен режим Домашний Wi-Fi"
            self.tray.showMessage("Nuntium OS — Сеть", msg, QSystemTrayIcon.MessageIcon.Information, 3000)

    def launch_tor(self) -> None:
        subprocess.Popen(["/usr/bin/nuntium-tor-browser"])

    def edit_config(self) -> None:
        subprocess.run(["pkexec", "/usr/libexec/nuntium-net-ctl", "init-config"], check=False)
        subprocess.Popen(["konsole", "-e", "sudo", "nano", "/etc/nuntium/vpn.toml"])

    def check_ip(self) -> None:
        try:
            with urllib.request.urlopen("https://api.ipify.org", timeout=6) as resp:
                ip = resp.read().decode("utf-8").strip()
            QMessageBox.information(None, "Внешний IP", f"Текущий внешний IP-адрес:\n\n{ip}")
        except Exception as exc:
            QMessageBox.warning(None, "Внешний IP", f"Не удалось получить внешний IP:\n{exc}")


def main() -> int:
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    _tray = NuntiumNetTray(app)
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())