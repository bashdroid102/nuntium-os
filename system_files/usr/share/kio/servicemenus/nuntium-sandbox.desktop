[Desktop Entry]
Type=Service
MimeType=application/x-ms-dos-executable;application/vnd.microsoft.portable-executable;application/x-msi;application/x-msdownload;
Actions=RunDialog;RunOffline;
X-KDE-Priority=TopLevel

[Desktop Action RunDialog]
Name=Запустить в песочнице Nuntium...
Icon=security-high
Exec=/usr/bin/nuntium-exe-sandbox %f

[Desktop Action RunOffline]
Name=Запустить в одноразовой песочнице без интернета
Icon=network-offline
Exec=/usr/bin/nuntium-exe-sandbox --no-gui --offline %f